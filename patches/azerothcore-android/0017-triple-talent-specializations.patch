     SPELL_ATTR7_ALWAYS_CAST_LOG                               = 0x80000000  // TITLE Client indicator (client only)
 };
 
-#define MAX_TALENT_SPECS        2
+#define MAX_TALENT_SPECS        3
+
+constexpr bool IsValidTalentSpecCount(uint8 count)
+{
+    return count >= 1 && count <= MAX_TALENT_SPECS;
+}
+
+constexpr bool IsValidTalentSpecIndex(uint8 spec, uint8 count)
+{
+    return IsValidTalentSpecCount(count) && spec < count;
+}
 #define MAX_GLYPH_SLOT_INDEX    6
 
