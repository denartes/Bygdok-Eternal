diff --git a/src/test/server/game/Entities/TripleTalentSpecTest.cpp b/src/test/server/game/Entities/TripleTalentSpecTest.cpp
new file mode 100644
index 0000000..66e6800
--- /dev/null
+++ b/src/test/server/game/Entities/TripleTalentSpecTest.cpp
@@ -0,0 +1,37 @@
+/*
