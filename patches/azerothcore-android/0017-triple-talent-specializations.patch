+ * with this program. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "SharedDefines.h"
+#include "gtest/gtest.h"
+
+TEST(TalentSpecializationSlotsTest, AllowsOneToThreeSlots)
+{
+    EXPECT_FALSE(IsValidTalentSpecCount(0));
+    EXPECT_TRUE(IsValidTalentSpecCount(1));
+    EXPECT_TRUE(IsValidTalentSpecCount(2));
+    EXPECT_TRUE(IsValidTalentSpecCount(3));
+    EXPECT_FALSE(IsValidTalentSpecCount(4));
+}
+
+TEST(TalentSpecializationSlotsTest, RejectsLockedAndOutOfRangeSlots)
+{
+    EXPECT_TRUE(IsValidTalentSpecIndex(0, 1));
+    EXPECT_TRUE(IsValidTalentSpecIndex(1, 2));
+    EXPECT_TRUE(IsValidTalentSpecIndex(2, 3));
+    EXPECT_FALSE(IsValidTalentSpecIndex(2, 2));
+    EXPECT_FALSE(IsValidTalentSpecIndex(3, 3));
+    EXPECT_FALSE(IsValidTalentSpecIndex(0, 0));
+}
