[worldserver]

########################################
# Reagent Bank Config
########################################
#
#    ReagentBank.Enable
#        Description: Enable reagent bank menus, deposits and withdrawals.
#                     Disabling preserves the NPC and stored reagents.
#        Default:     1 - Enabled
#                     0 - Disabled
#

ReagentBank.Enable = 1
